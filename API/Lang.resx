    <!--BuffEffects
    0 = name, 1 = element name, 2 = old aff, 3 = new aff
    Name's element affinity +5 → +6-->
    <data name="LogChangeAff" xml:space="preserve">
        <value>{0} {1} /c[#deff81]affinity {2} /c[white]→ {3}</value>
    </data>
    <!--0 = side ID, 1 = old bloom, 2 = new bloom, 3 = change
    Player/Opponent Team Bloom a → b (+c)-->
