        <value>{0,plural,=0{Player}=1{Opponent}} team /c[#deff81]Bloom {1} /c[white]→ {2} /c[white]({3}/c[white])</value>
    </data>
    <!--ChangeBooleanStat
    0 = name, 1 = value (0 = false, other = true)
    Name is no longer/now immune to x-->
    <data name="LogChangeBooleanStatEffectBlock" xml:space="preserve">
        <value>{0} {1,plural,=0{is no longer}other{is now}} immune to secondary skill effects</value>
    </data>
    <data name="LogChangeBooleanStatUnableToActImmune" xml:space="preserve">
        <value>{0} {1,plural,=0{is no longer}other{is now}} immune to becoming unable to act</value>
    </data>
    <data name="LogChangeBooleanStatEquipDisabledImmune" xml:space="preserve">
        <value>{0} {1,plural,=0{is no longer}other{is now}} immune to having their equipment disabled</value>
    </data>
    <!--2 = SP
    Name's SP a → b-->
    <data name="LogChangeBooleanStatInfiniteSp" xml:space="preserve">
        <value>{0} /c[#deff81]SP /c[#bb00ff]{1,plural,=0{∞}other{{2}}} /c[white]→ /c[#bb00ff]{1,plural,=0{{2}}other{∞}}</value>
    </data>
    <!--Name is no longer/now unable to act-->
    <data name="LogChangeBooleanStatUnableToAct" xml:space="preserve">
