<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- CS1591: Missing XML comment for publicly visible type or member 
        CS1573: Parameter has no matching param tag in the XML comment (but other parameters do)
        CA2211: Non-constant (static) fields should not be visible -->
        <NoWarn>1591, 1573, CA2211</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Apos.Shapes" Version="0.5.0" />
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.1" />
        <PackageReference Include="MessageFormat" Version="7.1.3" />
        <PackageReference Include="MonoGame.Extended" Version="5.2.0" />
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.2.0" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.12">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="OneOf" Version="3.0.271" />
        <PackageReference Include="ResolutionBuddy" Version="5.0.0" />
    </ItemGroup>
    <ItemGroup>
    <None Update="Lang/Lang.en-US.properties">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    </ItemGroup>
    <Target Name="GenerateBuildDate" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <BuildDate>$([System.DateTime]::Now.ToString("dd-MM-yyyy"))</BuildDate>
        </PropertyGroup>
        <WriteLinesToFile File="BuildInfo.cs" Lines="//------------------------------------------------------------------------------&#xA;// %3C/auto-generated%3E&#xA;//     This code was generated by a tool.&#xA;//&#xA;//     Changes to this file may cause incorrect behavior and will be lost if&#xA;//     the code is regenerated.&#xA;// %3C/auto-generated%3E&#xA;//------------------------------------------------------------------------------&#xA;&#xA;namespace API%3B&#xA;            &#xA;public static class BuildInfo&#xA;{&#xA;    public const string BuildDate = &quot;$(BuildDate)&quot;%3B&#xA;}" Overwrite="true" />
    </Target>
</Project>