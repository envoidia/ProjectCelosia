<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn> <!-- Missing XML comment for publicly visible type or member -->
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Apos.Shapes" Version="0.5.0" />
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.1" />
        <PackageReference Include="MessageFormat" Version="7.1.3" />
        <PackageReference Include="MonoGame.Extended" Version="5.2.0" />
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.2.0" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.12">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="OneOf" Version="3.0.271" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Lang.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Lang.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <Target Name="GenerateBuildDate" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <BuildDate>$([System.DateTime]::Now.ToString("dd-MM-yyyy"))</BuildDate>
        </PropertyGroup>
        <WriteLinesToFile File="BuildInfo.cs" Lines="//------------------------------------------------------------------------------
// %3C/auto-generated%3E
//     This code was generated by a tool.
//
//     Changes to this file may cause incorrect behavior and will be lost if
//     the code is regenerated.
// %3C/auto-generated%3E
//------------------------------------------------------------------------------

namespace API%3B
            
public static class BuildInfo {
    public const string BuildDate = &quot;$(BuildDate)&quot;%3B
}" Overwrite="true" />
    </Target>
</Project>