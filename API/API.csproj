<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>Preview</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.4.1" />
        <PackageReference Include="MonoGame.Extended" Version="5.1.0" />
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.1.0" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <None Update="fnt\koruri.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <Target Name="GenerateBuildDate" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <BuildDate>$([System.DateTime]::Now.ToString("dd-MM-yyyy"))</BuildDate>
            <Semicolon>test;</Semicolon>
        </PropertyGroup>
        <WriteLinesToFile File="BuildInfo.cs" Lines="// Automatically generated on build. Do not modify%0Anamespace API%3B%0A%0Apublic static class BuildInfo {%0A    public const string BuildDate = &quot;$(BuildDate)&quot;%3B%0A}" Overwrite="true" />
    </Target>
</Project>