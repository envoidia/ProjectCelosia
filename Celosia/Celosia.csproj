<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2"/>
        <PackageReference Include="MonoGame.Extended" Version="5.2.0"/>
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.2.0"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.12"/>
        <ProjectReference Include="..\API\API.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Lang.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Lang.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Lang.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Lang.resx</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
