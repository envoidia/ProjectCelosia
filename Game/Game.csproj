<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
    <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- CS1591: Missing XML comment for publicly visible type or member
        CS1573: Parameter has no matching param tag in the XML comment (but other parameters do)
        CA2211: Non-constant (static) fields should not be visible -->
        <NoWarn>1591, 1573, CA2211</NoWarn>

        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>

        <MonoGameExtendedPipelineReferencePath
        >$(MSBuildThisFileDirectory)pipeline-references</MonoGameExtendedPipelineReferencePath>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />

        <None Update="Font/koruri.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="Font/lilex.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <PackageReference Include="Apos.Shapes" Version="0.6.6-alpha" />
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.3" />
        <PackageReference Include="MessageFormat" Version="7.1.3" />
        <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.3.1" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
        <PackageReference Include="ResolutionBuddy" Version="5.0.0" />

        <ProjectReference Include="../API/API.csproj" />
        <ProjectReference Include="../Celosia/Celosia.csproj" />
    </ItemGroup>

    <Target Name="EnsureContentOutputPath" BeforeTargets="CopyFilesToOutputDirectory">
        <MakeDir Directories="$(OutDir)Content/img" />
    </Target>

    <Target Name="MoveFiles" AfterTargets="Build" Condition="'$(PublishAot)' == 'false'">
        <Move SourceFiles="$(TargetDir)Celosia.dll" DestinationFolder="$(TargetDir)Mods" />
    </Target>
</Project>
