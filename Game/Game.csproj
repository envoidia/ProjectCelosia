<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: Missing XML comment for publicly visible type or member 
        CS1573: Parameter has no matching param tag in the XML comment (but other parameters do)
        CA2211: Non-constant (static) fields should not be visible -->
        <NoWarn>1591, 1573, CA2211</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
        <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <PropertyGroup>
        <MonoGameExtendedPipelineReferencePath>$(MSBuildThisFileDirectory)pipeline-references</MonoGameExtendedPipelineReferencePath>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico"/>
        <None Remove="Icon.bmp"/>
        <None Update="Font\koruri.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Apos.Shapes" Version="0.5.0"/>
        <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.1"/>
        <PackageReference Include="MessageFormat" Version="7.1.3"/>
        <PackageReference Include="MonoGame.Extended" Version="5.2.0"/>
        <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="5.2.0"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.12"/>
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5-develop.12"/>
        <PackageReference Include="ResolutionBuddy" Version="5.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\API\API.csproj"/>
        <ProjectReference Include="..\Celosia\Celosia.csproj"/>
    </ItemGroup>
    <!-- <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
        <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High"/>
        <Exec Command="dotnet tool restore"/>
    </Target> -->
    <Target Name="EnsureContentOutputPath" BeforeTargets="CopyFilesToOutputDirectory">
        <MakeDir Directories="$(OutDir)Content/img"/>
    </Target>
    <Target Name="MoveFiles" AfterTargets="Build" Condition="'$(PublishAot)' == 'false'">
        <Move SourceFiles="$(TargetDir)Celosia.dll" DestinationFolder="$(TargetDir)Mods"/>
    </Target>
</Project>